      "exe": "contenta.exe",
      "installFolder": "ContentaConverter",
      "overrideEnv": "CONTENTASOFT_CC_EXE",
      "websiteUrl": "https://www.contenta-converter.com/",
      "downloadUrl": "https://www.contenta-converter.com/download.php",
      "privacyUrl": "https://www.contenta-converter.com/privacy.php",
