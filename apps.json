      "tools": ["recompress_video", "batch_recompress", "analyze_video", "estimate_savings", "list_presets"],
      "networkNote": ""
    },
    {
      "key": "aive",
      "package": "@contentasoft/ai-video-enhancer-mcp",
      "bin": "ai-video-enhancer-mcp",
